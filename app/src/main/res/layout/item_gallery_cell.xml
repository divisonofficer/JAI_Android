<?xml version="1.0" encoding="utf-8"?>
<!-- One capture: its RGB picture, square like the capture, and the time it was taken. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1AFFFFFF"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/mode_pill"
        android:fontFamily="monospace"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        app:layout_constraintStart_toStartOf="@id/thumb"
        tools:text="09-30 12:10" />

    <!-- An HDR burst, as opposed to a single pair. -->
    <TextView
        android:id="@+id/badge_hdr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/mode_pill"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/viewer_hdr"
        android:textColor="@color/camera_accent"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb"
        tools:visibility="visible" />

    <!-- The scene this capture is assigned to, if any. -->
    <TextView
        android:id="@+id/scene_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/mode_pill"
        android:ellipsize="end"
        android:maxWidth="80dp"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="@color/camera_ok"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        tools:text="desk A"
        tools:visibility="visible" />

    <!-- Shown while the cell is part of a multi-selection. -->
    <View
        android:id="@+id/selected_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/selection_frame"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintStart_toStartOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />

</androidx.constraintlayout.widget.ConstraintLayout>
